APP_ENV=production
MARKET_PROVIDER=free
NEWS_PROVIDER=gdelt
# Optional authoritative calendar/news JSON or RSS feed. When blank, EdgeOne
# polls GDELT and Google News for the rolling past 7-day history window.
GLOBAL_EVENTS_URL=
# Optional official/licensed future-event calendar JSON/RSS feed. When blank,
# the public economic calendar below is polled and clearly labelled as public
# (not an exchange-authorized quote source). Rows may use scheduledAt, eventAt,
# eventDate, releaseAt or date.
GLOBAL_CALENDAR_URL=
# Optional display name for GLOBAL_CALENDAR_URL.
GLOBAL_CALENDAR_NAME=
EVENTS_FETCH_TIMEOUT_MS=8000
CALENDAR_FETCH_TIMEOUT_MS=3500
# Leave blank in Docker: Nginx proxies /api to FastAPI. Set to
# http://localhost:8000 only when running the API separately in development.
NEXT_PUBLIC_API_URL=
DATABASE_URL=postgresql://qijian:qijian@postgres:5432/qijian
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000,https://emcdb.com,https://www.emcdb.com
MARKET_DATA_API_KEY=
NEWS_API_KEY=
# Free key: live gold/silver spot + USD/CNY FX and daily copper/WTI reference.
# Keep this server-side; do not expose it as a VITE/NEXT_PUBLIC variable.
ALPHAVANTAGE_API_KEY=
# Optional licensed/authorized COMEX Gold continuous quote feed. The JSON
# response should contain a last/price/close field and may include change_pct,
# as_of and delayed. GC1! is shown as USD per troy ounce; no spot fallback.
COMEX_GOLD_FUTURES_URL=
COMEX_GOLD_FUTURES_TOKEN=
FRED_API_KEY=
CFTC_APP_TOKEN=
# Public domestic futures adapter. The endpoint must be an authorized official
# delayed/redistributed feed returning {items:[{symbol,price,change_pct,as_of}]}.
DOMESTIC_DELAYED_URL=
DOMESTIC_DELAYED_TOKEN=
# Optional official-authorized China futures adapters. Leave blank until the
# provider grants an API/feed entitlement; the app never scrapes webpages.
THS_IFIND_ACCESS_TOKEN=
# Prefer the long-lived iFinD refresh token in production. The server
# exchanges it for a short-lived access_token and keeps that token in memory.
THS_IFIND_REFRESH_TOKEN=
THS_IFIND_API_URL=
THS_IFIND_TOKEN_URL=https://quantapi.51ifind.com/api/v1/get_access_token
# Optional comma-separated THS_RQ indicators. The default set is safe for the
# five futures cards; only request fields enabled for your account.
THS_IFIND_INDICATORS=latest,changeRatio,open,high,low,volume
THS_CONTRACT_CODES={"au":"AU.SHF","ag":"AG.SHF","cu":"CU.SHF","sn":"SN.SHF","sc":"SC.INE"}
THS_NEWS_FEED_URL=
EASTMONEY_CHOICE_TOKEN=
EASTMONEY_CHOICE_API_URL=
EASTMONEY_CONTRACT_CODES=
EASTMONEY_NEWS_FEED_URL=
# Choice historical/research data is isolated from realtime CSQ/CSQS. The
# endpoint below is a trusted HTTPS sidecar that calls the official SDK c.csd;
# the public site never guesses a Choice HTTP URL or exposes licensed rows.
EASTMONEY_CHOICE_HISTORY_TOKEN=
EASTMONEY_CHOICE_HISTORY_API_URL=
EASTMONEY_CHOICE_HISTORY_INDICATORS=open,high,low,close,volume
EASTMONEY_CHOICE_HISTORY_TIMEOUT_MS=5000
# Keep false until Choice/your exchange grants realtime or minute entitlement.
EASTMONEY_CHOICE_REALTIME_ENABLED=false
CHINA_SOURCE_TIMEOUT_MS=8000
# Private owner-only gate. Keep the access code server-side in EdgeOne.
PRIVATE_ACCESS_CODE=
# Ordinary visitor phone accounts. Use a different secret from
# PRIVATE_ACCESS_CODE; the browser never receives either secret.
PUBLIC_AUTH_SECRET=
# Privacy-first visitor statistics. Generate a strong random value and keep it
# server-side; daily visitor hashes cannot be reconstructed without this key.
VISITOR_ANALYTICS_SECRET=
VISITOR_RETENTION_DAYS=90
# SMS_PROVIDER=tencent_cloud sends through Tencent Cloud SMS. Required keys
# are listed below. For local-only testing use SMS_PROVIDER=console; it never
# exposes the code in the browser and is disabled when APP_ENV=production.
SMS_PROVIDER=tencent_cloud
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_ATTEMPTS=5
SMS_DAILY_LIMIT=10
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SMS_REGION=ap-guangzhou
TENCENTCLOUD_SMS_SDK_APP_ID=
TENCENTCLOUD_SMS_SIGN_NAME=
TENCENTCLOUD_SMS_TEMPLATE_ID=
# Optional HTTPS webhook alternative. Do not use an untrusted URL.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
# CTP cannot be held as a raw TCP session inside Pages; point this at your own
# mainland collector/bridge after it has connected to the futures company.
CTP_BRIDGE_URL=
CTP_BRIDGE_TOKEN=
# Production visual analysis. Keep the key server-side in EdgeOne/FastAPI;
# the browser never receives it. If unset, uploads fail clearly and no demo
# conclusion is shown.
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
# Backward-compatible alias accepted by the image-analysis adapter.
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=25
HTTP_TIMEOUT_SECONDS=8
SENTRY_DSN=
