# SimNow/CTP Bridge 本机示例；复制后填写，不要提交真实值。
CTP_MODE=simnow
CTP_MD_FRONT=
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=

# 使用当日实际存在的完整合约代码，逗号分隔；不要订阅不存在的月份。
CTP_INSTRUMENTS=au2610,ag2610,cu2610,sn2610,sc2610
CTP_FLOW_PATH=.cache/ctp-flow
CTP_USER_PRODUCT_INFO=qijian-simnow
CTP_INTERFACE_PRODUCT_INFO=qijian-simnow

# 只有 SimNow/期货公司明确要求时填写；Bridge 会优先尝试客户端认证。
CTP_APP_ID=
CTP_AUTH_CODE=

# /board 必须使用 Bearer 令牌；不要关闭鉴权。
CTP_BRIDGE_TOKEN=
CTP_STALE_AFTER_MS=5000
CTP_BRIDGE_ALLOW_UNAUTHENTICATED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
