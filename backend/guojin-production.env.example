# 国金期货生产 CTP Bridge（只读行情）示例；复制到受信主机后填写，不要提交真实值。
# 生产前置、BrokerID、账号和认证字段必须以国金期货为准，不能沿用仿真地址。
CTP_MODE=guojin_production
CTP_PROFILE=guojin_production
CTP_MD_FRONT=
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=

# 使用当日实际存在的完整合约代码，逗号分隔；只订阅本人获授权的合约。
CTP_INSTRUMENTS=au2610,ag2610,cu2610,sn2610,sc2610
CTP_FLOW_PATH=.cache/ctp-flow-guojin-production
CTP_USER_PRODUCT_INFO=qijian-guojin
CTP_INTERFACE_PRODUCT_INFO=qijian-guojin

# 看穿式/客户端认证字段仅在国金明确下发时填写。
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_SDK_VERSION=production-v6.7.13

# /board 必须使用 Bearer 令牌；不要关闭鉴权或把 8787 直接暴露到公网。
CTP_BRIDGE_TOKEN=
CTP_STALE_AFTER_MS=5000
CTP_BRIDGE_ALLOW_UNAUTHENTICATED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
