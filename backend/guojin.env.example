# 国金期货 CTP Bridge 本机示例；复制后填写，不要提交真实值。
# 仿真二选一：guojin_sim_telecom（成都电信）或 guojin_sim_unicom（成都联通）。
# 生产使用 guojin_production，并必须填写国金期货下发的生产行情前置。
CTP_MODE=guojin_sim
CTP_PROFILE=guojin_sim_telecom
CTP_MD_FRONT=
CTP_BROKER_ID=1010
CTP_USER_ID=
CTP_PASSWORD=

# 使用当日实际存在的完整合约代码，逗号分隔；不要订阅不存在的月份。
CTP_INSTRUMENTS=au2610,ag2610,cu2610,sn2610,sc2610
CTP_FLOW_PATH=.cache/ctp-flow-guojin
CTP_USER_PRODUCT_INFO=qijian-guojin
CTP_INTERFACE_PRODUCT_INFO=qijian-guojin

# 只有国金期货明确要求时填写；不同 API 版本的认证能力可能不同。
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_SDK_VERSION=evaluation-v6.7.10

# /board 必须使用 Bearer 令牌；不要关闭鉴权。
CTP_BRIDGE_TOKEN=
CTP_STALE_AFTER_MS=5000
CTP_BRIDGE_ALLOW_UNAUTHENTICATED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
